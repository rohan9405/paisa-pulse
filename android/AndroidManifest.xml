<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.paisapulse.app">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <!-- Read-only access to the SMS inbox to pick up bank alerts. Nothing is sent off the phone. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Downloads the remote config file and sends anonymous usage counts (opt-out) to the same service (backend/). The WebView blocks every other outside URL; SMS and financial data are never sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Fingerprint app lock (optional, off by default). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application android:usesCleartextTraffic="false" android:label="drip" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".DripWidgetProvider" android:exported="false" android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/drip_widget_info" />
        </receiver>
        <service android:name=".WidgetSyncService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <receiver android:name=".WidgetSmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter><action android:name="android.provider.Telephony.SMS_RECEIVED" /></intent-filter>
        </receiver>
    </application>
</manifest>
